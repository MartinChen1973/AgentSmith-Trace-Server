# Trace server listen address
AGENTSMITH_TRACE_HOST=127.0.0.1
AGENTSMITH_TRACE_PORT=9000
# If 9000 is stuck (zombie listener serving an old UI), use 9001 instead:
# AGENTSMITH_TRACE_PORT=9001

# SQLite database path
AGENTSMITH_TRACE_DB=./agentsmith_trace.db

# Auto-reload: 1 = uvicorn watches src/ and restarts on save (local dev).
# Set to 0 only if reload causes port/zombie issues on Windows.
AGENTSMITH_TRACE_RELOAD=1
